{
    "manifest_version": 3,
    "name": "Playback Speed Controller",
    "version": "1.0",
    "description": "Change playback speed of videos with a slider.",
    "permissions": ["scripting", "activeTab"],
    "host_permissions": ["<all_urls>"],
    "action": {
      "default_popup": "popup.html",
      "default_icon": "icon.png"
    }
  }